#!/usr/bin/env python3
"""Read-only touchscreen edge gesture monitor for the Armada overlay."""

import errno
import fcntl
import glob
import json
import os
import pathlib
import select
import socket
import struct
import time

EV_SYN = 0
EV_KEY = 1
EV_ABS = 3
SYN_REPORT = 0
BTN_TOUCH = 330
ABS_MT_SLOT = 47
ABS_MT_TRACKING_ID = 57
ABS_MT_POSITION_X = 53
ABS_MT_POSITION_Y = 54
ABS_X = 0
ABS_Y = 1
EVIOCGABS = 0x80184540
INPUT_EVENT = struct.Struct("llHHi")
DEFAULTS = {"swipeEnabled": True, "swipeEdge": "left", "swipeDistance": 120}
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "armada/overlay.json"
RUNTIME = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
CONTROL_SOCKET = pathlib.Path(os.environ.get(
    "ARMADA_OVERLAY_CONTROL_SOCKET", RUNTIME / "armada-control-overlay/control.sock"
))


def read_text(path):
    try:
        return pathlib.Path(path).read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def has_bit(path, bit):
    raw = read_text(path).replace(" ", "")
    try:
        return bool(int(raw or "0", 16) & (1 << bit))
    except ValueError:
        return False


def abs_info(fd, code):
    data = bytearray(24)
    try:
        fcntl.ioctl(fd, EVIOCGABS + code, data, True)
        _value, minimum, maximum, _fuzz, _flat, _resolution = struct.unpack("iiiiii", data)
    except OSError:
        return None
    return minimum, maximum


def touchscreen_candidates():
    for sys_path in sorted(glob.glob("/sys/class/input/event*/device")):
        name = read_text(pathlib.Path(sys_path) / "name")
        lowered = name.casefold()
        abs_caps = pathlib.Path(sys_path) / "capabilities/abs"
        has_multitouch = has_bit(abs_caps, ABS_MT_POSITION_X) and has_bit(abs_caps, ABS_MT_POSITION_Y)
        named_touch = "touchscreen" in lowered or "touch screen" in lowered
        if not name or not has_multitouch and not named_touch:
            continue
        event = pathlib.Path(sys_path).parent.name
        yield pathlib.Path("/dev/input") / event, sys_path


class TouchDevice:
    def __init__(self, path, sys_path):
        self.path = pathlib.Path(path)
        self.fd = os.open(self.path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        self.sys_path = pathlib.Path(sys_path)
        self.x_code = ABS_MT_POSITION_X
        self.y_code = ABS_MT_POSITION_Y
        self.x_range = abs_info(self.fd, self.x_code)
        self.y_range = abs_info(self.fd, self.y_code)
        if not self.x_range or not self.y_range:
            self.x_code = ABS_X
            self.y_code = ABS_Y
            self.x_range = abs_info(self.fd, self.x_code)
            self.y_range = abs_info(self.fd, self.y_code)
        if not self.x_range or not self.y_range:
            os.close(self.fd)
            raise OSError("touchscreen has no usable coordinate range")
        self.multitouch = has_bit(self.sys_path / "capabilities/abs", ABS_MT_POSITION_X)
        self.slot = 0
        self.contacts = {}
        self.single = {"x": 0, "y": 0, "touching": False}
        self.buffer = b""

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass

    def _contact(self):
        return self.contacts.setdefault(self.slot, {"x": 0, "y": 0, "active": False})

    def _snapshot(self):
        if self.multitouch:
            return [value for value in self.contacts.values() if value["active"]]
        return [self.single] if self.single["touching"] else []

    def read_contacts(self):
        snapshots = []
        while True:
            try:
                chunk = os.read(self.fd, INPUT_EVENT.size * 32)
            except BlockingIOError:
                break
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                    break
                raise
            if not chunk:
                break
            self.buffer += chunk
            usable = len(self.buffer) - len(self.buffer) % INPUT_EVENT.size
            data, self.buffer = self.buffer[:usable], self.buffer[usable:]
            for _seconds, _microseconds, event_type, code, value in INPUT_EVENT.iter_unpack(data):
                if event_type == EV_ABS:
                    if self.multitouch and code == ABS_MT_SLOT:
                        self.slot = max(0, value)
                    elif self.multitouch and code == ABS_MT_TRACKING_ID:
                        if value < 0:
                            self.contacts.pop(self.slot, None)
                        else:
                            contact = self._contact()
                            contact["active"] = True
                    elif code == self.x_code:
                        (self._contact() if self.multitouch else self.single)["x"] = value
                    elif code == self.y_code:
                        (self._contact() if self.multitouch else self.single)["y"] = value
                elif event_type == EV_KEY and code == BTN_TOUCH:
                    self.single["touching"] = bool(value)
                elif event_type == EV_SYN and code == SYN_REPORT:
                    snapshots.append(self._snapshot())
        return snapshots

    def normalize(self, contacts):
        x_min, x_max = self.x_range
        y_min, y_max = self.y_range
        x_span = max(1, x_max - x_min)
        y_span = max(1, y_max - y_min)
        return [
            ((contact["x"] - x_min) / x_span, (contact["y"] - y_min) / y_span)
            for contact in contacts
        ]


def gesture_started(edge, x, y):
    if edge == "left":
        return x <= 0.08
    if edge == "right":
        return x >= 0.92
    return y >= 0.92


def gesture_reached(edge, start_x, start_y, x, y, distance):
    if edge == "left":
        return x - start_x >= distance
    if edge == "right":
        return start_x - x >= distance
    return start_y - y >= distance


def load_config():
    result = dict(DEFAULTS)
    try:
        stored = json.loads(CONFIG.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return result
    if not isinstance(stored, dict):
        return result
    if isinstance(stored.get("swipeEnabled"), bool):
        result["swipeEnabled"] = stored["swipeEnabled"]
    if stored.get("swipeEdge") in {"left", "right", "bottom"}:
        result["swipeEdge"] = stored["swipeEdge"]
    if isinstance(stored.get("swipeDistance"), (int, float)):
        result["swipeDistance"] = max(48, min(320, float(stored["swipeDistance"])))
    return result


def show_overlay():
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.25)
            client.connect(str(CONTROL_SOCKET))
            client.sendall(b"show\n")
    except OSError:
        pass


def main():
    devices = {}
    poller = select.poll()
    gesture = {"active": False, "invalid": False, "start_x": 0.0, "start_y": 0.0, "started": 0.0}
    last_scan = 0.0
    while True:
        now = time.monotonic()
        if now - last_scan >= 5:
            last_scan = now
            known = set()
            for path, sys_path in touchscreen_candidates():
                known.add(str(path))
                if str(path) in devices:
                    continue
                try:
                    device = TouchDevice(path, sys_path)
                except OSError:
                    continue
                devices[str(path)] = device
                poller.register(device.fd, select.POLLIN)
            for path, device in list(devices.items()):
                if path in known and device.path.exists():
                    continue
                poller.unregister(device.fd)
                device.close()
                del devices[path]

        config = load_config()
        for fd, _event in poller.poll(1000):
            device = next((item for item in devices.values() if item.fd == fd), None)
            if not device:
                continue
            for contacts in device.read_contacts():
                points = device.normalize(contacts)
                if len(points) > 1:
                    gesture["invalid"] = True
                if not points:
                    gesture.update(active=False, invalid=False)
                    continue
                if not config["swipeEnabled"]:
                    continue
                x, y = points[0]
                if not gesture["active"]:
                    if len(points) == 1 and gesture_started(config["swipeEdge"], x, y):
                        gesture.update(active=True, invalid=False, start_x=x, start_y=y, started=time.monotonic())
                    continue
                if gesture["invalid"] or time.monotonic() - gesture["started"] > 0.7:
                    continue
                distance = float(config["swipeDistance"]) / max(
                    1.0, float(device.x_range[1] - device.x_range[0] if config["swipeEdge"] != "bottom" else device.y_range[1] - device.y_range[0])
                )
                if gesture_reached(config["swipeEdge"], gesture["start_x"], gesture["start_y"], x, y, distance):
                    gesture["active"] = False
                    show_overlay()


if __name__ == "__main__":
    main()
