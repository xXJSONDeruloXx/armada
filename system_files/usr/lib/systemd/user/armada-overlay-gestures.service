[Unit]
Description=Armada touchscreen edge gesture monitor
PartOf=armada-control-overlay.service armada-opengamepadui.service
After=armada-control-overlay.service armada-opengamepadui.service

[Service]
ExecStart=/usr/libexec/armada/overlay-gestures
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
