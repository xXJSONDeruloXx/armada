[Unit]
Description=Armada Control game-mode overlay
PartOf=gamescope-session-plus@steam.service
After=graphical-session.target
Wants=graphical-session.target

[Service]
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/usr/bin/armada-control-overlay --persistent
ExecStopPost=-/usr/libexec/armada/inputplumber-intercept reset
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
