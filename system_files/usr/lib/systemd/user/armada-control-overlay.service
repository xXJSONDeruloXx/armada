[Unit]
Description=Armada Control game-mode overlay
PartOf=gamescope-session-plus@steam.service
After=graphical-session.target
After=gamescope-session-plus@steam.service
Wants=graphical-session.target

[Service]
Environment=QT_QPA_PLATFORM=xcb
ExecStartPre=-/usr/bin/armada-control-overlay --cleanup
ExecStart=/usr/bin/armada-control-overlay --persistent
ExecStopPost=-/usr/bin/armada-control-overlay --cleanup
ExecStopPost=-/usr/libexec/armada/inputplumber-intercept reset
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
