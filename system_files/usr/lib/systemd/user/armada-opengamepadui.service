[Unit]
Description=Armada OpenGamepadUI overlay
PartOf=gamescope-session-plus@steam.service
After=graphical-session.target
After=gamescope-session-plus@steam.service
Wants=graphical-session.target

[Service]
ExecStart=/usr/bin/armada-opengamepadui --overlay-mode
ExecStopPost=-/usr/libexec/armada/inputplumber-intercept reset
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
