+
+static int qcom_pcie_set_diag_suspend_opp(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->pci->dev;
+	struct dev_pm_opp *opp;
+	int ret;
+
+	opp = dev_pm_opp_find_freq_exact(dev, 2, true);
 	if (IS_ERR(opp))
 		return PTR_ERR(opp);
 
 	ret = dev_pm_opp_set_opp(dev, opp);
+	if (!ret)
+		pcie->diag_opp_active = true;
 	dev_pm_opp_put(opp);
 
 	return ret;
@@ -2249,6 +2268,13 @@
 					dev_err(dev, "Failed to set suspend OPP: %d\n",
 						ret);
 			}
+		} else if (pcie->use_pm_opp &&
+			   of_property_read_bool(dev->of_node,
+						 "armada,diag-pcie-mem-suspend-opp")) {
+			ret = qcom_pcie_set_diag_suspend_opp(pcie);
+			if (ret)
+				dev_err(dev, "Failed to set diagnostic PCIe sleep OPP: %d\n",
+					ret);
 		}
 	}
 	return ret;
@@ -2310,6 +2336,16 @@
 		}
 	}
 
+	if (pcie->diag_opp_active) {
+		ret = qcom_pcie_set_max_opp(dev);
+		if (ret) {
+			dev_err(dev, "Failed to restore PCIe OPP after diagnostic suspend: %d\n",
+				ret);
+			return ret;
+		}
+		pcie->diag_opp_active = false;
+	}
+
 	qcom_pcie_icc_opp_update(pcie);
 
 	return 0;
