#!/usr/bin/env sh
set -eu

user_home="${HOME:?HOME is not set}"
data_home="${XDG_DATA_HOME:-${user_home}/.local/share}"
plugin_dir="${data_home}/opengamepadui/plugins"
plugin_archive="/usr/share/armada/ogui/armada-control.zip"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/armada"
runtime_marker="${runtime_dir}/opengamepadui.pid"

mkdir -p "${plugin_dir}"
if [ -f "${plugin_archive}" ]; then
    if [ ! -f "${plugin_dir}/armada-control.zip" ] || ! cmp -s "${plugin_archive}" "${plugin_dir}/armada-control.zip"; then
        cp "${plugin_archive}" "${plugin_dir}/armada-control.zip"
    fi
fi

runtime="/usr/share/armada/ogui/opengamepad-ui.aarch64"

# OGUI needs a display, but user services do not inherit one from the
# Gamescope session. Prefer the X11 socket whose root window carries
# Gamescope focus state, falling back to the first X11 socket.
discover_display() {
    first=""
    for sock in "${X11_SOCKET_DIR:-/tmp/.X11-unix}"/X*; do
        [ -e "$sock" ] || continue
        n="${sock##*/X}"
        case "$n" in ''|*[!0-9]*) continue;; esac
        [ -z "$first" ] && first=":$n"
        if DISPLAY=":$n" xprop -root GAMESCOPE_FOCUSED_WINDOW >/dev/null 2>&1; then
            printf '%s\n' ":$n"
            return 0
        fi
    done
    [ -n "$first" ] && printf '%s\n' "$first" && return 0
    return 1
}
if [ -z "${DISPLAY:-}" ]; then
    if found="$(discover_display)"; then
        DISPLAY="$found"
        export DISPLAY
    fi
fi

cleanup() {
    rm -f "${runtime_marker}"
    /usr/libexec/armada/inputplumber-intercept reset >/dev/null 2>&1 || true
}
trap cleanup EXIT

"${runtime}" "$@" &
runtime_pid=$!
mkdir -p "${runtime_dir}"
printf '%s\n' "${runtime_pid}" > "${runtime_marker}"
trap 'kill -TERM "${runtime_pid}" 2>/dev/null || true; exit 143' INT TERM
wait "${runtime_pid}" || status=$?
exit "${status:-0}"
